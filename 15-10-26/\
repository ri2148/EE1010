

import numpy as np
import matplotlib.pyplot as plt
import subprocess
import shlex

# 1. Define theoretical parameters
# PDF: P(x) = C * x^2 for x in [1, 4] where C = 1/21
C = 1 / 21

def theoretical_pdf(x):
    return np.where((x >= 1) & (x <= 4), C * (x ** 2), 0)

# 2. Inverse Transform Sampling
# CDF: F(x) = (x^3 - 1) / 63  for x in [1, 4]
# Inverse CDF: F^{-1}(u) = (63 * u + 1)^(1/3)
def sample_custom_pdf(num_samples):
    u = np.random.uniform(0, 1, num_samples)
    return (63 * u + 1) ** (1 / 3)

# 3. Simulate and generate samples
num_samples = 100000
samples = sample_custom_pdf(num_samples)

# 4. Calculate simulated probability P(2 <= X <= 3)
p_simulated = np.mean((samples >= 2) & (samples <= 3))
p_theoretical = 19 / 63

print(f"Simulated P(2 <= X <= 3)   : {p_simulated:.4f}")
print(f"Theoretical P(2 <= X <= 3) : {p_theoretical:.4f}")

# 5. Plotting histogram vs theoretical PDF
x_vals = np.linspace(0.5, 4.5, 1000)
y_vals = theoretical_pdf(x_vals)

plt.figure(figsize=(8, 5))
plt.hist(samples, bins=50, density=True, alpha=0.6, color='skyblue', edgecolor='black', label='Simulated Samples')
plt.plot(x_vals, y_vals, 'r-', lw=2, label=r'Theoretical PDF: $P(x) = \frac{1}{21}x^2$')

# Highlight the area P(2 <= X <= 3)
plt.axvspan(2, 3, color='orange', alpha=0.3, label=r'Region $2 \le X \le 3$')

plt.title('Simulation of Continuous PDF using Inverse Transform Sampling')
plt.xlabel('x')
plt.ylabel('Density')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.7)
plt.savefig("plot.pdf", dpi=100)
subprocess.run(shlex.split("termux-open plot.pdf"))
